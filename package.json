{
  "name": "mvc-lab",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run lint && vite build && npm run test",
    "preview": "vite preview --port 5000",
    "start": "vite --port 5000",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint \"src/js/**/*.js\"",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:html": "html-validate \"index.html\"",
    "format": "prettier --write \"./index.html\" \"./src/**/*.{js,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "17.12",
    "html-validate": "11.16",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
